# Copy to .env.local for local development, or set these in Railway / Vercel.

# --- Database ---------------------------------------------------------------
# Leave empty locally to use the embedded database in .data/pglite.
# In production, use a PostgreSQL connection string (Railway Postgres, Neon, ...).
DATABASE_URL=
# Set to true if your Postgres host requires SSL (Neon, most managed hosts).
DATABASE_SSL=false
# Set to false to start with an empty catalog instead of the placeholder products.
SEED_PLACEHOLDER_PRODUCTS=true

# --- First admin ------------------------------------------------------------
# Created on first start if no admin exists yet. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site URL ---------------------------------------------------------------
# Public URL, used for payment return pages and webhooks, e.g. https://diginest.up.railway.app
APP_URL=

# --- NOWPayments (crypto) ---------------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# true = use api-sandbox.nowpayments.io with sandbox keys
NOWPAYMENTS_SANDBOX=false

# --- Binance Pay ------------------------------------------------------------
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
# How many USDT one euro buys. Binance Pay charges in USDT; update this as the rate moves.
BINANCE_PAY_USDT_PER_EUR=

# --- Demo payments ----------------------------------------------------------
# Providers without keys run in demo mode (a "simulate payment" button) during development.
# In production, demo mode is off unless this is true. Never enable it on a live store.
ALLOW_DEMO_PAYMENTS=false
